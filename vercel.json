{
  "outputDirectory": "public",
  "env": {
    "STUDYMETA_DEMO_MODE": "true",
    "STUDYMETA_LEARNER_PROFILE_TYPE": "synthetic_demo"
  },
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30
    },
    "api/learner-context.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/student-preview",
      "destination": "/student-preview.html"
    },
    {
      "source": "/student-dashboard-preview",
      "destination": "/student-dashboard-preview.html"
    },
    {
      "source": "/student-session-preview",
      "destination": "/student-session-preview.html"
    },
    {
      "source": "/oauth/consent",
      "destination": "/api/oauth-consent"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/openai-apps-challenge"
    }
  ]
}
