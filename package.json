{
  "name": "studymeta-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "dev:http": "tsx src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-static.mjs",
    "start": "node dist/src/http.js",
    "start:stdio": "node dist/src/stdio.js",
    "test": "node --import tsx --test tests/mcp.integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/supabase-js": "2.112.4",
    "dotenv": "17.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
