# StudyMeta MCP 서버 연동에 필요한 값입니다.
# 실제 값은 이 파일에 채우지 말고 로컬 .env(커밋 금지) 또는 Vercel 프로젝트의
# Environment Variables 설정에 넣어주세요.
#
# 아래 두 값은 이 코드를 작성한 세션이 직접 알 수 없는 값입니다 — MCP 서버를
# 관리하는 팀원에게 확인해서 받아야 합니다. 자세한 확인 절차는
# MCP_INTEGRATION.md를 참고하세요.

# 1) StudyMeta MCP 서버 엔드포인트 URL.
#    예: https://mcp.studymeta.example.com/mcp
MCP_SERVER_URL=

# 2) 서버-서버 인증 토큰. 이 백엔드는 사람이 아니라 서버 프로세스로서 MCP
#    서버를 호출하므로, Claude 세션이 쓰는 사용자 OAuth 토큰과는 별개로
#    MCP 서버 쪽에서 발급하는 정적 서비스 토큰(또는 이에 준하는 인증 수단)이
#    필요합니다. MCP 서버가 사람 사용자의 OAuth 인가만 지원한다면 이 자리에
#    토큰을 넣는 방식 자체를 다시 설계해야 합니다.
MCP_API_KEY=

# 3) (선택) 전송 방식. 기본값은 최신 MCP 표준인 Streamable HTTP다.
#    MCP 서버가 SSE(Server-Sent Events) 전송만 지원한다면 sse로 바꾼다.
MCP_TRANSPORT=streamable-http
