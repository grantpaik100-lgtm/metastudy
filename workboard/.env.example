# Copy to .env.local. It is ignored by Git and excluded from the deployment bundle.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WORKBOARD_URL=https://YOUR_WORKBOARD.vercel.app
WORKBOARD_BOARD_ID=studymeta
# Server-only: authenticates the daily recording retention job.
CRON_SECRET=
