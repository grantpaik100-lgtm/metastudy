{
  "buildCommand": "node cloud/build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "regions": ["icn1"],
  "functions": { "api/gateway.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?route=/api/:path*" },
    { "source": "/mcp", "destination": "/api/gateway?route=/mcp" },
    { "source": "/oauth/:path*", "destination": "/api/gateway?route=/oauth/:path*" },
    { "source": "/.well-known/:path*", "destination": "/api/gateway?route=/.well-known/:path*" }
  ],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"SAMEORIGIN"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"}
  ]}]
}
